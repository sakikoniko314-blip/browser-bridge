{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "1.0.0",
  "description": "WebSocket bridge for AI assistant browser control",
  "permissions": ["tabs", "scripting", "cookies", "storage", "activeTab", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Bridge"
  }
}
